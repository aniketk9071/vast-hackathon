# ─── Database (local PostgreSQL) ──────────────────────────────────────────────
# For Docker: this is auto-set in docker-compose.yml — no change needed
# For local dev without Docker: install PostgreSQL and create the DB:
#   createdb skillshub
DATABASE_URL="postgresql://skillshub:skillshub123@localhost:5432/skillshub"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"

# ─── Ollama (Local AI — FREE, no API key needed) ──────────────────────────────
# For Docker: auto-set to http://ollama:11434 in docker-compose.yml
# For local dev: keep as localhost
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
