# Copy this to .env.local before running docker-compose
# cp .env.docker.example .env.local

# DATABASE_URL is set automatically in docker-compose.yml (local PostgreSQL container)
# No need to change this.

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="ynbajk6ypxRP5eZXHQ9dFz52UCx9krfWbQy1o9vRJjc="

# ─── Ollama ───────────────────────────────────────────────────────────────────
# Model to use (default: llama3.2). Other options: mistral, qwen2.5:7b
OLLAMA_MODEL="llama3.2"
